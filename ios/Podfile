# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

pod 'GoogleUtilities', :modular_headers => true
pod 'FirebaseCoreInternal', :modular_headers => true
pod 'GoogleDataTransport', :modular_headers => true
pod 'nanopb', :modular_headers => true

# App size: calls are voice only, so Agora's optional add-ons (video, face,
# lip sync, spatial audio, screen capture...) are not embedded. AgoraRtcKit
# needs only the frameworks kept below, and the Iris wrapper links the add-ons
# weakly, so leaving them out is safe. The AI noise-suppression and echo-
# cancellation add-ons stay. Only the Ionicons icon font is used.
AGORA_KEPT_FRAMEWORKS = %w[
  AgoraRtcKit aosl Agoraffmpeg Agorafdkaac AgoraSoundTouch video_dec
  AgoraAiEchoCancellationExtension AgoraAiEchoCancellationLLExtension
  AgoraAiNoiseSuppressionExtension AgoraAiNoiseSuppressionLLExtension
].map { |name| "#{name}.xcframework" }

pre_install do |installer|
  installer.pod_targets.each do |pod|
    spec = pod.root_spec.attributes_hash
    case pod.name
    when 'AgoraVideo_Special_iOS'
      all = Array(spec['vendored_frameworks'])
      dropped = (all - AGORA_KEPT_FRAMEWORKS).map { |f| File.basename(f, '.xcframework') }
      spec['vendored_frameworks'] = all & AGORA_KEPT_FRAMEWORKS
      # The spec also weak-links every add-on by name; the linker fails on ones
      # that are no longer there.
      spec['weak_frameworks'] = Array(spec['weak_frameworks']) - dropped
    when 'RNVectorIcons'
      spec['resources'] = ['Fonts/Ionicons.ttf']
    end
  end
end

target 'Tooka' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 supports iOS 15.0+ only and fails the build when a pod target declares
    # an older IPHONEOS_DEPLOYMENT_TARGET (e.g. GoogleUtilities privacy bundles at 12.0,
    # PromisesObjC at 9.0). Raise any such target to the app's own minimum.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current) < Gem::Version.new(min_ios_version_supported)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
